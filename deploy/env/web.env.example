NODE_ENV=production
DEPLOYMENT_VERSION=replace-with-git-sha
APP_BASE_URL=https://dispecing.linkapomoci.sk
MOTORIST_DEV_AUTH_BYPASS=false
MOTORIST_ORGANIZATION_SLUG=pomoc-motoristom
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Set true only after the additive schema is installed. Keep true while
# draining; HOTDESK_ENABLED=false then stops new claims without bypassing
# existing lease fences.
VIPTEL_WORKPLACE_HOTDESK_RUNTIME_ENABLED=false
VIPTEL_WORKPLACE_HOTDESK_ENABLED=false
# Explicit runtime stage: local | controlled_test | production. Production
# templates use production; an empty/unknown value keeps hot-desk fail-closed.
VIPTEL_WORKPLACE_DEPLOYMENT_STAGE=production
# Modes: disabled | trusted_test | production_static_pilot | production_revocable.
VIPTEL_WORKPLACE_HOTDESK_MODE=disabled
# Used only by trusted_test. production_static_pilot authorizes every
# authenticated telephony-capable operator through the API role guard.
VIPTEL_WORKPLACE_HOTDESK_PROFILE_IDS=
VIPTEL_WORKPLACE_QUEUE_CAPABILITY=unverified
VIPTEL_WORKPLACE_QUEUE_EVIDENCE_ID=
VIPTEL_WORKPLACE_QUEUE_PROBE_PROFILE_ID=
VIPTEL_WORKPLACE_QUEUE_PROBE_SOURCE_EXTENSION=
VIPTEL_WORKPLACE_QUEUE_PROBE_STARTS_AT=
VIPTEL_WORKPLACE_QUEUE_PROBE_ENDS_AT=
VIPTEL_WORKPLACE_QUEUE_PROBE_FALLBACK_REFERENCE=
VIPTEL_WORKPLACE_CREDENTIAL_PROVIDER=static_viptel
# Leave empty by default. An approved production_static_pilot requires exactly:
# I_ACCEPT_NON_REVOCABLE_STATIC_SIP_PILOT
VIPTEL_WORKPLACE_STATIC_SIP_PILOT_ACKNOWLEDGEMENT=
VIPTEL_WORKPLACE_RESUME_SECRET_KEY=
