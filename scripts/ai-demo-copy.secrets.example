# Tokens for scripts/setup-ai-demo-copy.sh. This file is gitignored.
# Never paste these into a chat; fill them in here and let the script read them.

# https://vercel.com/account/settings/tokens  (scope: the team that owns the app)
VERCEL_TOKEN=
# Team slug or id. Leave empty for a personal account.
VERCEL_SCOPE=
# The project the environment is copied FROM (this copy of the app, not the original).
SOURCE_VERCEL_PROJECT=pomoc-motoristom-new

# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Organisation that will own the new project: visible in the dashboard URL
# https://supabase.com/dashboard/org/<this-part>/general
SUPABASE_ORG_ID=
# A fresh password for the new database. Invent one; nothing else uses it.
SUPABASE_DB_PASSWORD=

# Optional overrides
COPY_NAME=pomoc-motoristom-aidemo
SUPABASE_REGION=eu-central-1
SEED_DEMO_DATA=true
