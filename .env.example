NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-legacy-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_PROJECT_REF=replace-with-project-ref
SUPABASE_DB_URL=replace-with-supabase-pooled-database-url
MOTORIST_ORGANIZATION_SLUG=pomoc-motoristom
MOTORIST_ORGANIZATION_ID=
# Explicitný prepínač dev auth bypassu. Prázdne = default (zap v NODE_ENV=development, inak vyp).
# "false" = vynúť guardy aj lokálne (prod-like test), "true" = vypni auth (len dev).
MOTORIST_DEV_AUTH_BYPASS=false
SUPABASE_READ_TIMEOUT_MS=4500
APP_BASE_URL=http://localhost:3000
DEPLOYMENT_VERSION=development
WORKER_INSTANCE_ID=motorist-local-1
SCHEDULER_ENABLED=false
ALERT_EMAIL_TO=info@alfopure.tech
HEALTHCHECKS_PING_URL=
# Runtime worker smie mať iba read-only Hetzner token; provisioning write token sem nepatrí.
HCLOUD_READ_TOKEN=

EMAIL_PROVIDER=resend
EMAIL_FROM=Pomoc Motoristom <noreply@example.com>
EMAIL_REPLY_TO=dispecing@example.com
EMAIL_APP_NAME=Pomoc Motoristom
RESEND_API_KEY=replace-with-resend-api-key
RESEND_WEBHOOK_SECRET=

VIPTEL_REST_BASE_URL=https://pbxmanager.viptel.sk/
VIPTEL_WEBSOCKET_URL=wss://pbxwssv1.viptel.sk:8088/
VIPTEL_USERNAME=replace-with-server-only-username
VIPTEL_PASSWORD=replace-with-server-only-password
VIPTEL_DEFAULT_EXTENSION=20
VIPTEL_CALLER_ID=0412289240
VIPTEL_REQUEST_TIMEOUT_MS=8000
VIPTEL_ALLOWED_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Fail-closed gate for every provider-affecting telephony action and browser SIP
# credential issuance. Keep false in Preview. The token must be a separate,
# server-only random value with at least 32 characters before enabling production.
VIPTEL_LIVE_MUTATIONS_ENABLED=false
VIPTEL_LIVE_MUTATION_TOKEN=replace-me
# Independent kill switch for manager/admin takeover of a disconnected shared
# workplace. Keep false until extensions 20-23 pass the workplace_claim preflight.
VIPTEL_WORKPLACE_ADMIN_TAKEOVER_ENABLED=false
# Dynamic hot-desk lease flow. Enable the runtime only after the additive DB
# migration is present. During rollback/drain keep RUNTIME enabled and switch
# HOTDESK_ENABLED off; this blocks new claims while preserving active leases,
# heartbeat, leave/recovery and all telephone fences. Disable RUNTIME only
# after an audited zero-leases/zero-operations decommission.
VIPTEL_WORKPLACE_HOTDESK_RUNTIME_ENABLED=false
# `trusted_test` is limited to non-production and the explicit UUID allowlist.
# `production_revocable` additionally requires verified queue evidence and an
# implemented revocable credential adapter. The exceptional
# `production_static_pilot` is available to every authenticated telephony
# operator and requires the exact explicit acknowledgement below; it does not
# make static VIPTel credentials revocable.
# Resume key must be an independent server-only random value.
VIPTEL_WORKPLACE_HOTDESK_ENABLED=false
# Explicit runtime stage checked by the hot-desk capability gate. Allowed:
# local | controlled_test | production. Empty/unknown values fail closed.
VIPTEL_WORKPLACE_DEPLOYMENT_STAGE=local
# Modes: disabled | trusted_test | production_static_pilot | production_revocable.
VIPTEL_WORKPLACE_HOTDESK_MODE=trusted_test
VIPTEL_WORKPLACE_HOTDESK_PROFILE_IDS=
VIPTEL_WORKPLACE_QUEUE_CAPABILITY=unverified
VIPTEL_WORKPLACE_QUEUE_EVIDENCE_ID=
# A `trusted_test` controlled_probe may vacate exactly one named queued seat,
# for one pilot profile and a maximum 12-hour ISO-8601 window. The evidence ID must point to
# the matching immutable approval audit; every VIPTel queue must have 0 waiting
# calls. The fallback reference is an audit label, never a password or token.
VIPTEL_WORKPLACE_QUEUE_PROBE_PROFILE_ID=
VIPTEL_WORKPLACE_QUEUE_PROBE_SOURCE_EXTENSION=
VIPTEL_WORKPLACE_QUEUE_PROBE_STARTS_AT=
VIPTEL_WORKPLACE_QUEUE_PROBE_ENDS_AT=
VIPTEL_WORKPLACE_QUEUE_PROBE_FALLBACK_REFERENCE=
VIPTEL_WORKPLACE_CREDENTIAL_PROVIDER=static_viptel
# Not a secret. Leave empty by default. For an explicitly approved production
# static-SIP pilot only, use exactly: I_ACCEPT_NON_REVOCABLE_STATIC_SIP_PILOT
VIPTEL_WORKPLACE_STATIC_SIP_PILOT_ACKNOWLEDGEMENT=
VIPTEL_WORKPLACE_RESUME_SECRET_KEY=replace-with-independent-random-secret
# Personal identities eligible for the fixed 601 -> 602 -> 603 priority plan.
VIPTEL_DISPATCH_PERSONAL_EXTENSIONS=20,21,22,23

VIPTEL_SIP_WEBPHONE_ENABLED=false
# Explicit local-development fallback only; ignored unless NODE_ENV=development.
VIPTEL_WEBPHONE_MOCK_ENABLED=false
# VIPTel SIP-over-WSS (WebRTC) gateway for SIP.js. This is the SIP transport,
# NOT the event/control API (pbxwssv1.viptel.sk:8088 is the event API and makes
# SIP.js fail before REGISTER). Confirmed live endpoint for this tenant:
VIPTEL_SIP_WS_URL=wss://wss-cloud.viptel.sk:8443
VIPTEL_SIP_DOMAIN=pomocmotor.cloud.viptel.sk
VIPTEL_SIP_REALM=pomocmotor.cloud.viptel.sk
VIPTEL_SIP_OUTBOUND_PROXY=
VIPTEL_SIP_BROWSER_REGISTRATION_ALLOWED=true
VIPTEL_SIP_ALLOWED_ORIGINS=http://localhost:3000
VIPTEL_SIP_CODECS=opus,G722,PCMU,PCMA,GSM
VIPTEL_SIP_DTMF_MODE=rfc2833
VIPTEL_SIP_STUN_URLS=
VIPTEL_SIP_TURN_URLS=
VIPTEL_SIP_TURN_USERNAME=
VIPTEL_SIP_TURN_CREDENTIAL=
VIPTEL_SIP_EXPOSE_BROWSER_CREDENTIALS=false
VIPTEL_WEBPHONE_DIAL_MODE=sip_invite
VIPTEL_WEBPHONE_EXTENSIONS=20,21,22,23
VIPTEL_WEBPHONE_20_LABEL=Osobna klapka 20
VIPTEL_WEBPHONE_20_AUTH_USERNAME=20
VIPTEL_WEBPHONE_20_PASSWORD=replace-with-personal-20-password
VIPTEL_WEBPHONE_20_OUTBOUND_CALLER_ID=0412289240
VIPTEL_WEBPHONE_20_CAN_CALL_EXTERNAL=true
VIPTEL_WEBPHONE_21_LABEL=Osobna klapka 21
VIPTEL_WEBPHONE_21_AUTH_USERNAME=21
VIPTEL_WEBPHONE_21_PASSWORD=replace-with-personal-21-password
VIPTEL_WEBPHONE_21_OUTBOUND_CALLER_ID=0412289240
VIPTEL_WEBPHONE_21_CAN_CALL_EXTERNAL=true
VIPTEL_WEBPHONE_22_LABEL=Osobna klapka 22
VIPTEL_WEBPHONE_22_AUTH_USERNAME=22
VIPTEL_WEBPHONE_22_PASSWORD=replace-with-personal-22-password
VIPTEL_WEBPHONE_22_OUTBOUND_CALLER_ID=0412289240
VIPTEL_WEBPHONE_22_CAN_CALL_EXTERNAL=true
VIPTEL_WEBPHONE_23_LABEL=Osobna klapka 23
VIPTEL_WEBPHONE_23_AUTH_USERNAME=23
VIPTEL_WEBPHONE_23_PASSWORD=replace-with-personal-23-password
VIPTEL_WEBPHONE_23_OUTBOUND_CALLER_ID=0412289240
VIPTEL_WEBPHONE_23_CAN_CALL_EXTERNAL=true

VIPTEL_SMS_BASE_URL=https://smsapi.viptel.sk/api/
VIPTEL_SMS_USERNAME=replace-with-server-only-sms-username
VIPTEL_SMS_PASSWORD=replace-with-server-only-sms-password
VIPTEL_SMS_FROM_IDENTITY=replace-with-leading-zero-identity-from-identities-endpoint
VIPTEL_SMS_LIVE_SENDS=false
VIPTEL_SMS_TEST_MSISDN=replace-with-00421-test-number
VIPTEL_SMS_WEBHOOK_TOKEN=replace-with-server-only-webhook-token
VIPTEL_SMS_REQUEST_TIMEOUT_MS=8000
SMS_PROVIDER=viptel_sms
LOCATION_LINK_TOKEN_PEPPER=replace-with-server-only-random-location-link-pepper

# Server-only WebDispecink API v2 discovery/sync credentials. Do not expose them
# to browser code and do not commit real values.
WEBDISPECINK_SOAP_URL=https://api.webdispecink.cz/code/WebDispecinkServiceNet.php
WEBDISPECINK_COMPANY_CODE=replace-with-company-code-kodf
WEBDISPECINK_USERNAME=replace-with-api-username
WEBDISPECINK_PASSWORD=replace-with-api-password
WEBDISPECINK_ACTIVE_ONLY=1
WEBDISPECINK_GEOCODE=0
WEBDISPECINK_SHOW_COORDINATES=0
WEBDISPECINK_REQUEST_TIMEOUT_MS=12000
WEBDISPECINK_SYNC_TOKEN=replace-with-optional-cron-token
WEBDISPECINK_SYNC_ENABLED=true
CRON_SECRET=replace-with-vercel-cron-bearer-token

# Server-only Commander GPS sync credentials for replacement vehicles.
COMMANDER_API_BASE_URL=https://online.commander-systems.com/api/v1
COMMANDER_API_USERNAME=replace-with-server-only-commander-username
COMMANDER_API_PASSWORD=replace-with-server-only-commander-password
COMMANDER_SYNC_SECRET=replace-with-strong-server-only-sync-secret

# Call recordings pipeline (Bearer guard for /api/telephony/recordings/sync and
# /api/telephony/viptel/cdr/probe; also stored in GitHub Actions secrets).
RECORDINGS_SYNC_SECRET=replace-with-strong-server-only-sync-secret
# Days a recording stays in storage before the cleanup marks it deleted (default 90).
RECORDINGS_RETENTION_DAYS=90
# ElevenLabs Scribe STT for call transcripts (Phase 2).
ELEVENLABS_API_KEY=replace-with-server-only-elevenlabs-key
# Transcription feature gate (or add "transcripts" to the org's enabled_features).
TRANSCRIPTS_ENABLED=false
# Claude API for call summaries + QA scoring (Phase 3). AI step is skipped when unset.
ANTHROPIC_API_KEY=replace-with-server-only-anthropic-key

# Server-only key for Google Routes API. Do not expose this key in browser code.
GOOGLE_MAPS_API_KEY=replace-with-server-side-google-routes-key
# Browser key restricted to allowed HTTP referrers. Enable Maps JavaScript API
# and Places API in the same Google Cloud project.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-with-restricted-browser-key
# Optional Google Cloud Map ID for AdvancedMarkerElement. DEMO_MAP_ID works for local smoke tests.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

AI_TRANSCRIPT_ENABLED=false

# SWHouse náhradné vozidlá (read-only). Server-only — nikdy nevystavovať v browseri.
# basic = brána (Authorization: Basic), login = GET /rest/login UserAuth → JWT token.
SWHOUSE_API_BASE_URL=https://app.pomocmotoristom.sk/rest
SWHOUSE_BASIC_USERNAME=replace-with-server-only-swhouse-basic-username
SWHOUSE_BASIC_PASSWORD=replace-with-server-only-swhouse-basic-password
SWHOUSE_LOGIN_USERNAME=replace-with-server-only-swhouse-login-username
SWHOUSE_LOGIN_PASSWORD=replace-with-server-only-swhouse-login-password
# JSON mapovanie SWHouse pobočky (lasFilialId) -> naše motorist_branches.id, napr. {"1":"<branch-uuid>","6":"<branch-uuid>"}
SWHOUSE_BRANCH_MAP=
# CSV ownerTypeId hodnôt tvoriacich náhradnú flotilu v SWHouse (default "3,4" = Náhradné vozidlo + Pomoc motoristom).
SWHOUSE_FLEET_OWNER_TYPE_IDS=
# Cache voľných vozidiel (default 45000 ms), číselníkov (default 6 h)
# a sieťový timeout (default 8000 ms; all-roster má interne aspoň 25000 ms).
SWHOUSE_OCCUPANCY_TTL_MS=
SWHOUSE_CODELIST_TTL_MS=
SWHOUSE_REQUEST_TIMEOUT_MS=
# TTL cache pre autoritatívny GET /rest/carOccupancy/getCarsOccupancyAll, default 600000 (10 min).
SWHOUSE_CARS_TTL_MS=
# Bearer secret pre roster sync route /api/integrations/swhouse/sync (Fáza 2, cron swhouse-sync.yml).
SWHOUSE_SYNC_SECRET=replace-with-strong-server-only-sync-secret
