NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-legacy-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_PROJECT_REF=replace-with-project-ref
SUPABASE_DB_URL=replace-with-supabase-pooled-database-url
MOTORIST_ORGANIZATION_SLUG=pomoc-motoristom
MOTORIST_ORGANIZATION_ID=
# Explicitný prepínač dev auth bypassu. Prázdne = default (zap v NODE_ENV=development, inak vyp).
# "false" = vynúť guardy aj lokálne (prod-like test), "true" = vypni auth (len dev).
MOTORIST_DEV_AUTH_BYPASS=false

# Optional stable signing secret for saved vehicle observations. Server-only.
VEHICLE_LOOKUP_SIGNING_KEY=
# During a planned rotation, retain the former key here to read existing observations.
VEHICLE_LOOKUP_PREVIOUS_SIGNING_KEY=
SUPABASE_READ_TIMEOUT_MS=4500
APP_BASE_URL=http://localhost:3000
DEPLOYMENT_VERSION=development
WORKER_INSTANCE_ID=motorist-local-1
SCHEDULER_ENABLED=false
ALERT_EMAIL_TO=info@alfopure.tech
HEALTHCHECKS_PING_URL=

EMAIL_PROVIDER=resend
EMAIL_FROM=Pomoc Motoristom <noreply@example.com>
EMAIL_REPLY_TO=dispecing@example.com
EMAIL_APP_NAME=Pomoc Motoristom
RESEND_API_KEY=replace-with-resend-api-key
RESEND_WEBHOOK_SECRET=

# Telnyx telephony (Call Control + WebRTC) and SMS. Server-only; never expose in
# browser code. Resource IDs come from the Telnyx portal / API (see
# docs/operations/telnyx-setup.md); the contract is docs/telnyx-data-contract.md
# and the procedures are docs/operations/telnyx-runbook.md.
# Missing TELNYX_API_KEY => getTelnyxConfig().configured === false: telephony
# routes answer 503 and the UI shows "Telefónia nie je nakonfigurovaná".
TELNYX_API_KEY=replace-with-server-only-telnyx-api-key
# Public key from GET /v2/public_key. Verifies the Ed25519 signature over
# `${telnyx-timestamp}|${rawBody}` on both webhook routes (tolerance 300 s).
# When unset the webhooks answer 503, not 400: nothing can be verified.
TELNYX_PUBLIC_KEY=replace-with-telnyx-webhook-public-key
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
# Per-environment resources: dev IDs on Preview and `dev`, production IDs on `main`.
# Webhook events whose payload.connection_id matches neither of the first two are
# ignored with 200, so a cross-environment mix-up drops calls silently.
TELNYX_CALL_CONTROL_APP_ID=
TELNYX_CREDENTIAL_CONNECTION_ID=
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
TELNYX_MESSAGING_PROFILE_ID=
# Alphanumeric SMS sender. One-way: replies cannot be received.
TELNYX_SMS_ALPHA_SENDER=PomocMotor
# Canonical string from GET /v2/phone_numbers (E.164), used for outbound calls
# when the operator has no line preference. Must be a number that can originate:
# the +421232408718 line is the current default (spike S3 in the runbook).
TELNYX_DEFAULT_FROM_NUMBER=
# Kill switches. Keep both false in Preview; they are ANDed with
# motorist_telephony_settings.live_calls_enabled / sms_live_sends, and a missing
# settings row counts as off. While off, dial/transfer answer 423 and SMS sends
# answer 423; in-call cleanup (hangup, bridge, playback, conference) stays allowed.
TELNYX_LIVE_CALLS_ENABLED=false
TELNYX_SMS_LIVE_SENDS=false
# Base URL of the directory that serves public/telephony/*.mp3 (MOH, greetings, IVR).
# No fallback: it must include the /telephony path, e.g. https://<host>/telephony.
# When unset the code falls back to Telnyx TTS instead of the recorded prompts.
TELNYX_MEDIA_BASE_URL=
SMS_PROVIDER=telnyx
# Bearer token for the single Vercel cron (*/5 * * * * -> /api/telephony/cron:
# ring sweep, stuck-session detection, webhook ledger prune) and fleet sync routes.
CRON_SECRET=replace-with-vercel-cron-bearer-token
LOCATION_LINK_TOKEN_PEPPER=replace-with-server-only-random-location-link-pepper

# Server-only WebDispecink API v2 discovery/sync credentials. Do not expose them
# to browser code and do not commit real values.
WEBDISPECINK_SOAP_URL=https://api.webdispecink.cz/code/WebDispecinkServiceNet.php
WEBDISPECINK_COMPANY_CODE=replace-with-company-code-kodf
WEBDISPECINK_USERNAME=replace-with-api-username
WEBDISPECINK_PASSWORD=replace-with-api-password
WEBDISPECINK_ACTIVE_ONLY=1
WEBDISPECINK_GEOCODE=0
WEBDISPECINK_SHOW_COORDINATES=0
WEBDISPECINK_REQUEST_TIMEOUT_MS=12000
WEBDISPECINK_SYNC_TOKEN=replace-with-optional-cron-token
WEBDISPECINK_SYNC_ENABLED=true

# Server-only Commander GPS sync credentials for replacement vehicles.
COMMANDER_API_BASE_URL=https://online.commander-systems.com/api/v1
COMMANDER_API_USERNAME=replace-with-server-only-commander-username
COMMANDER_API_PASSWORD=replace-with-server-only-commander-password
COMMANDER_SYNC_SECRET=replace-with-strong-server-only-sync-secret

# Bearer guard for the transcript processing route (/api/telephony/transcripts/process).
RECORDINGS_SYNC_SECRET=replace-with-strong-server-only-sync-secret
# ElevenLabs Scribe STT for call transcripts (Phase 2).
ELEVENLABS_API_KEY=replace-with-server-only-elevenlabs-key
# Transcription feature gate (or add "transcripts" to the org's enabled_features).
TRANSCRIPTS_ENABLED=false
# Claude API for call summaries + QA scoring (Phase 3). AI step is skipped when unset.
ANTHROPIC_API_KEY=replace-with-server-only-anthropic-key

# Server-only key for Google Routes API. Do not expose this key in browser code.
GOOGLE_MAPS_API_KEY=replace-with-server-side-google-routes-key
# Browser key restricted to allowed HTTP referrers. Enable Maps JavaScript API
# and Places API in the same Google Cloud project.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-with-restricted-browser-key
# Optional Google Cloud Map ID for AdvancedMarkerElement. DEMO_MAP_ID works for local smoke tests.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

AI_TRANSCRIPT_ENABLED=false

# SWHouse náhradné vozidlá (read-only). Server-only — nikdy nevystavovať v browseri.
# basic = brána (Authorization: Basic), login = GET /rest/login UserAuth → JWT token.
SWHOUSE_API_BASE_URL=https://app.pomocmotoristom.sk/rest
SWHOUSE_BASIC_USERNAME=replace-with-server-only-swhouse-basic-username
SWHOUSE_BASIC_PASSWORD=replace-with-server-only-swhouse-basic-password
SWHOUSE_LOGIN_USERNAME=replace-with-server-only-swhouse-login-username
SWHOUSE_LOGIN_PASSWORD=replace-with-server-only-swhouse-login-password
# JSON mapovanie SWHouse pobočky (lasFilialId) -> naše motorist_branches.id, napr. {"1":"<branch-uuid>","6":"<branch-uuid>"}
SWHOUSE_BRANCH_MAP=
# CSV ownerTypeId hodnôt tvoriacich náhradnú flotilu v SWHouse (default "3,4" = Náhradné vozidlo + Pomoc motoristom).
SWHOUSE_FLEET_OWNER_TYPE_IDS=
# Cache voľných vozidiel (default 45000 ms), číselníkov (default 6 h)
# a sieťový timeout (default 8000 ms; all-roster má interne aspoň 25000 ms).
SWHOUSE_OCCUPANCY_TTL_MS=
SWHOUSE_CODELIST_TTL_MS=
SWHOUSE_REQUEST_TIMEOUT_MS=
# TTL cache pre autoritatívny GET /rest/carOccupancy/getCarsOccupancyAll, default 600000 (10 min).
SWHOUSE_CARS_TTL_MS=
# Bearer secret pre roster sync route /api/integrations/swhouse/sync (Fáza 2, cron swhouse-sync.yml).
SWHOUSE_SYNC_SECRET=replace-with-strong-server-only-sync-secret
