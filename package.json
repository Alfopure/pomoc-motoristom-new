{
  "name": "motorist-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/assert-target-project.mjs && next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker.mjs --alias:server-only=./src/test/stubs/server-only.ts --tsconfig=tsconfig.json",
    "build:one-shot": "esbuild src/worker/one-shot-index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/one-shot.mjs --alias:server-only=./src/test/stubs/server-only.ts --tsconfig=tsconfig.json",
    "build:production": "pnpm build && pnpm build:worker && pnpm build:one-shot",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "webdispecink:discover": "node scripts/webdispecink-discovery.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@telnyx/webrtc": "^2.27.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
