{
  "name": "motorist-dispatch-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.30",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "lucide-react-native": "1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store"
        ]
      }
    }
  }
}
